# /etc/systemd/system/veld-relay.service
# Install: sudo cp veld-relay.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now veld-relay
#
# The identity keystore (/etc/veld-relay/identity.json) MUST persist across
# restarts, upgrades, and redeploys. Peers pin the relay's X25519 public key
# (coord.relay_x25519) and address (coord.relay_addr) directly in their own
# configs — the coord server does NOT distribute them — so a new identity
# invalidates every peer's configuration until they are all updated.
#
# Provision the identity (and the dedicated veld-relay user) BEFORE the
# first start. Run the provisioning step as the veld-relay user so the
# directory (/etc/veld-relay, mode 0700) and keystore (identity.json, mode 0600)
# are owned by veld-relay and readable by the service:
#          sudo useradd --system --no-create-home --shell /sbin/nologin veld-relay
#          sudo -u veld-relay /usr/local/bin/veld-relay -gen-identity -identity /etc/veld-relay/identity.json
# The keystore is created with mode 0600 owned by veld-relay and the relay's
# X25519 public key is printed to stdout. See docs/RELAY.md for the full
# deployment guide.

[Unit]
Description=Veld Volunteer Relay (DERP-style fallback for peers that cannot hole-punch)
Documentation=https://github.com/veldmesh/veld
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Dedicated unprivileged user (create with: sudo useradd --system --no-create-home --shell /sbin/nologin veld-relay)
User=veld-relay

ExecStart=/usr/local/bin/veld-relay \
    -listen :41820 \
    -identity /etc/veld-relay/identity.json

# Restart on failure with backoff, mirroring the other Veld units.
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60s

# Log to the journal (explicit; read with: journalctl -u veld-relay).
StandardOutput=journal
StandardError=journal

# :41820 is an unprivileged port (>1024), so the service needs no
# CAP_NET_BIND_SERVICE. If you change -listen to a port below 1024,
# uncomment both lines so the unprivileged user can still bind:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The identity is provisioned before first start and only read here, so the
# filesystem can stay locked down.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target